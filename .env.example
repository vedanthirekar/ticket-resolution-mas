LUMA_ENVIRONMENT=development
LUMA_LOG_LEVEL=INFO
LUMA_DATABASE_URL=postgresql+psycopg://luma:luma_dev_only@localhost:5432/luma
LUMA_DATABASE_ECHO=false
LUMA_OPERATIONS_USERNAME=operations
LUMA_OPERATIONS_PASSWORD=change-me-before-production
LUMA_OPERATIONS_DISPLAY_NAME="Luma Operations"
LUMA_SESSION_TTL_HOURS=8
LUMA_WORKER_LEASE_SECONDS=120
LUMA_WORKER_POLL_SECONDS=1
LUMA_MODEL_PROVIDER=openrouter
LUMA_MODEL_NAME=minimax/minimax-m3:free
# The application rejects OpenRouter model names without the :free suffix.
# LUMA_MODEL_API_KEY=replace-with-an-OpenRouter-key
LUMA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-provider HTTP attempt timeout. The stage timeout below includes retries.
LUMA_MODEL_TIMEOUT_SECONDS=30
LUMA_MODEL_STAGE_TIMEOUT_SECONDS=180
LUMA_MODEL_MAX_RETRIES=2
LUMA_MODEL_MAX_OUTPUT_TOKENS=2000
# Optional; leave unset when provider pricing has not been pinned for the experiment.
# LUMA_MODEL_INPUT_COST_PER_MILLION_USD=0
# LUMA_MODEL_OUTPUT_COST_PER_MILLION_USD=0
LUMA_AGENT_MAX_TOOL_CALLS=8
LUMA_AGENT_MAX_SUPPLEMENTAL_CALLS=1

# Optional LangSmith export. Repository JSON reports remain authoritative.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=replace-with-langsmith-key
# LANGSMITH_PROJECT=luma-case-resolution

POSTGRES_DB=luma
POSTGRES_USER=luma
POSTGRES_PASSWORD=luma_dev_only
POSTGRES_PORT=5432

# Integration tests are opt-in so the default suite never requires Docker.
RUN_DB_TESTS=0
